          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.cookies.jar().clear(pm.request.url, function (error) {",
              "    if (error) { console.warn(\"No se pudieron limpiar las cookies:\", error); }",
              "});"
            ],
            "type": "text/javascript"
          }
        },
