        "body": {
          "mode": "raw",
          "raw": "{\n    \"titulo\": \"Falla mouse inalámbrico\",\n    \"descripcion\": \"No responde el puntero al reiniciar el equipo\",\n    \"categoria\": \"Hardware\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/solicitudes/",
          "host": ["{{base_url}}"],
          "path": ["solicitudes", ""]
        }
      }
    },
