  "item": [
    {
      "name": "00 - Obtener CSRF Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "let csrfCookie = pm.cookies.get(\"csrftoken\");",
              "if (csrfCookie) {",
              "    pm.collectionVariables.set(\"csrf_token\", csrfCookie);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/auth/csrf/",
          "host": ["{{base_url}}"],
          "path": ["auth", "csrf", ""]
        }
      }
    },
    {
      "name": "00 - Login Usuario Normal",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login exitoso (200)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "let csrfCookie = pm.cookies.get(\"csrftoken\");",
              "if (csrfCookie) {",
              "    pm.collectionVariables.set(\"csrf_token\", csrfCookie);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRFToken",
            "value": "{{csrf_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"juan_perez\",\n    \"password\": \"User123*\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["auth", "login", ""]
        }
      }
    },
    {
      "name": "01 - Usuario registra solicitud válida (201 Created)",
