    "name": "Soporte Técnico API - Evaluación Práctica N3",
    "description": "Colección completa para verificar los 10 escenarios solicitados en la evaluación de Django REST Framework.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
