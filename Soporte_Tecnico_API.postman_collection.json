    {
      "name": "04B - Usuario actualiza solicitud con PUT (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Los campos protegidos no fueron alterados\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.usuario).to.eql(\"juan_perez\");",
              "    pm.expect(jsonData.id).to.eql(Number(pm.variables.get(\"solicitud_id\")));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
